# Installed by OnionDesk. Only the local Tor process reaches this listener.
limit_req_zone $server_name zone=oniondesk_login:1m rate=5r/m;

server {
    listen 127.0.0.1:18080;
    server_name __ONION_HOST__;
    if ($host != "__ONION_HOST__") { return 444; }

    access_log off;
    error_log /var/log/nginx/oniondesk-error.log crit;
    server_tokens off;
    client_max_body_size 4k;
    client_body_timeout 10s;
    auth_request /auth-check;

    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    # no-referrer would turn Origin into null on browser form POSTs.
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' __NOVNC_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws://__ONION_HOST__; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    # Browser background icon requests must not replace a visible login form's
    # prelogin cookie by following a redirect to another login page.
    location = /favicon.ico {
        auth_request off;
        return 204;
    }

    location = /auth-check {
        internal;
        auth_request off;
        proxy_pass http://127.0.0.1:18081/auth-check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Original-Upgrade $http_upgrade;
    }

    location = /login {
        auth_request off;
        limit_req zone=oniondesk_login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header Connection "";
    }

    location = /logout {
        # Backend independently requires session, CSRF token, exact Host and Origin.
        auth_request off;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header Connection "";
    }

    location /novnc/ {
        alias /usr/share/novnc/;
        error_page 401 =302 http://__ONION_HOST__/login;
    }

    location = /ws/workstation {
        proxy_pass http://127.0.0.1:16082;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location = /ws/gateway {
        proxy_pass http://127.0.0.1:16081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        error_page 401 =302 http://__ONION_HOST__/login;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header Connection "";
    }
}
